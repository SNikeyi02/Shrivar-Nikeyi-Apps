@{
    ViewData["Title"] = "Add New Client";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-person-plus"></i> Register New Client</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateClient" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Email / Username</label>
                            <input type="email" name="Email" class="form-control" placeholder="client@example.com" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Full Name / Company Name</label>
                            <input type="text" name="Name" class="form-control" placeholder="Toyota Logistics" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Company / Client Description</label>
                            <textarea name="Description" class="form-control" rows="3" placeholder="Enter operational background details..." required></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Region</label>
                            <select name="Region" class="form-select">
                                <option value="Gauteng">Gauteng</option>
                                <option value="Western Cape">Western Cape</option>
                                <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                                <option value="International">International</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label font-weight-bold">Default Password</label>
                            <input type="password" name="Password" class="form-control" required minlength="6" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Create Client Profile</button>
                            <a asp-action="AdminDashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}