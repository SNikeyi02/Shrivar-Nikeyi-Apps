@model ERP.Models.Contract

<div>
    <h4>Contract Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Client Name</dt>
        <dd class="col-sm-10">@Model.Client?.Name</dd>

        <dt class="col-sm-2">Service Level Details</dt>
        <dd class="col-sm-10">
            <div class="p-3 bg-light border">
                @Model.ServiceLevel
            </div>
        </dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ContractId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>