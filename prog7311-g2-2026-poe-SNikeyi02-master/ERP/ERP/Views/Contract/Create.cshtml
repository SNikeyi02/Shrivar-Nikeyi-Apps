@model ERP.Models.Contract

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">New Service Contract</h3>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Contract Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Contract End Date</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ServiceLevel" class="form-label font-weight-bold"></label>
                    <select asp-for="ServiceLevel" class="form-select">
                        <option value="0">Basic Support</option>
                        <option value="1">Premium Support (24/7)</option>
                        <option value="2">Enterprise Logistics Tier</option>
                    </select>
                    <span asp-validation-for="ServiceLevel" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label font-weight-bold">Upload Agreement (PDF Only)</label>
                    <input type="file" name="AgreementFile" class="form-control" accept=".pdf" />
                    <small class="text-muted">Maximum file size allowed: 10MB</small>
                </div>

                <hr />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" asp-controller="Client" class="btn btn-secondary">Back to Dashboard</a>
                    <button type="submit" class="btn btn-success px-5">Submit Contract</button>
                </div>
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <strong><i class="bi bi-exclamation-octagon"></i> File Rejected:</strong>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}