@model ERP.Models.Contract

@{
    ViewData["Title"] = "Create Contract";
}

<h4>Create New Contract</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Client.ClientID" class="control-label">Client</label>
                <select asp-for="Client.ClientID" class="form-control" asp-items="ViewBag.ClientId"></select>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="EndDate" class="control-label">Expiration Date</label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Initial Status</label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<ERP.Enums.ContractStatus>()"></select>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Signed Agreement (PDF only)</label>
                <input type="file" name="AgreementFile" class="form-control" accept=".pdf" />
            </div>

            <div class="form-group">
                <input type="submit" value="Generate Contract" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>