@model ERP.Models.Contract

@{
    ViewData["Title"] = "Submit Signed Agreement";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-primary">
                <div class="card-header">
                    <h3>Upload Agreement</h3>
                </div>
                <div class="card-body">
                    <p><strong>Contract ID:</strong> @Model.ContractId</p>
                    <p class="text-muted">Please upload the signed PDF of your @Model.ServiceLevel service agreement.</p>

                    <form asp-action="UploadPDF" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="contractId" value="@Model.ContractId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">Select PDF File</label>
                            <input type="file" name="AgreementFile" class="form-control" accept=".pdf" required />
                            <div class="form-text">Only PDF documents are permitted.</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Upload and Submit</button>
                            <a asp-action="Index" class="btn btn-light">Back to Dashboard</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>