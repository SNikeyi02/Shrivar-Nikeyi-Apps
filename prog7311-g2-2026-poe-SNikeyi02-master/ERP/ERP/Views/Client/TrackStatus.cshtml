@model ERP.Models.Contract

@{
    ViewData["Title"] = "Contract Tracking";
}

<div class="container mt-4">
    <h4>Status Tracking for Contract: @Model.ContractId</h4>
    <hr />
    <div class="row">
        <div class="col-sm-4 font-weight-bold">Current Status:</div>
        <div class="col-sm-8">
            <h3 class="text-uppercase">@Model.Status</h3>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-sm-4 font-weight-bold">Service Level Description:</div>
        <div class="col-sm-8 bg-light p-3 border">
            @Model.ServiceLevel
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-sm-4 font-weight-bold">Valid Until:</div>
        <div class="col-sm-8">@Model.EndDate.ToLongDateString()</div>
    </div>
    
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">Return to Dashboard</a>
    </div>
</div>