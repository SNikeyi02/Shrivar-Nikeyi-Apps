@model IEnumerable<ERP.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Request Management";
}

<div class="container mt-4">
    <h1>All Service Requests</h1>

    <table class="table table-striped mt-4">
        <thead class="table-dark">
            <tr>
                <th>Client</th>
                <th>Type</th>
                <th>Weight (kg)</th>
                <th>Cost (USD)</th>
                <th>Cost (ZAR)</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Contract?.Client?.Name</td>
                    <td><span class="badge bg-secondary">@item.Type</span></td>
                    <td>@item.Weight</td>
                    <td>$@item.CostUSD.ToString("F2")</td>
                    <td>R @item.CostZAR.ToString("F2")</td>
                    <td>
                        <span class="badge @(item.Status == ERP.Enums.RequestStatus.Pending ? "bg-warning" : "bg-success")">
                            @item.Status
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.ServiceRequestId" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>