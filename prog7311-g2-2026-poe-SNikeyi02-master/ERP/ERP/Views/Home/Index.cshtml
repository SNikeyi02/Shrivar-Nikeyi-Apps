@model dynamic

@{
    ViewData["Title"] = "TechMove ERP - Access Portal";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">TechMove Logistics ERP</h1>
        <p class="lead text-muted">Enterprise Secure Access Gateway Infrastructure.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm col-md-10 offset-md-1" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Html.ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm col-md-10 offset-md-1">
            <div asp-validation-summary="All" class="text-danger fw-bold"></div>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 text-center"><i class="bi bi-shield-lock-fill text-warning me-2"></i>Secure Account Login</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Home" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email/Username address</label>
                            <input type="email" name="username" class="form-control form-control-lg border-secondary" placeholder="Enter your registered email" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Security Password</label>
                            <input type="password" name="password" class="form-control form-control-lg border-secondary" placeholder="••••••••" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm fw-bold">
                                Authenticate Login
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light py-3 text-center text-muted small">
                    Protected system ecosystem security layer.
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 text-center"><i class="bi bi-person-plus-fill me-2"></i>Admin Provisioning Portal</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Home" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Full Identity Name</label>
                            <input type="text" name="fullName" class="form-control border-primary" placeholder="e.g. Administrator Staff Member" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Corporate Email Address</label>
                            <input type="email" name="email" class="form-control border-primary" placeholder="name@techmove-erp.co.za" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Choose Password</label>
                            <input type="password" name="password" class="form-control border-primary" placeholder="Minimum 6 characters containing symbols" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Confirm Password</label>
                            <input type="password" name="confirmPassword" class="form-control border-primary" placeholder="Re-type selected password" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-bold">
                                Provision System Admin Account
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light py-3 text-center text-muted small">
                    Accounts initialized here hold administrative data operational access.
                </div>
            </div>
        </div>
    </div>
</div>