@model Prog_POE.Models.LoginView

<style>

    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', sans-serif;
        background-color: #D1D4C7; /* Light Gray-Green */
    }

    .login-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
    }

    .login-box {
        background-color: white;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(42, 115, 126, 0.2);
        width: 100%;
        max-width: 400px;
        text-align: center;
        border-top: 5px solid #1E8449;
    }

    .login-image img {
        width: 100%;
        max-width: 300px;
        margin-bottom: 20px;
        border-radius: 8px;
    }

    .form-group {
        margin-bottom: 15px;
        text-align: left;
    }

        .form-group label {
            display: block; 
            margin-bottom: 5px;
            font-weight: bold; 
            color: #333;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        border: 1px solid #65A8B4;
        border-radius: 5px;
        transition: border-color 0.3s ease;
    }

        .form-control:focus {
            outline: none;
            border-color: #2A737E; 
            box-shadow: 0 0 0 2px rgba(30, 132, 73, 0.2); 
        }

    .btn-primary {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        background-color: #1E8449;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        margin-top: 10px;
        transition: background-color 0.3s ease, transform 0.1s ease;
        font-weight: bold;
    }

        .btn-primary:hover {
            background-color: #2A737E;
            transform: translateY(-1px);
        }

    /* Input validation */
    .text-danger {
        color: #E74C3C;
        font-size: 14px;
        display: block;
        margin-top: 5px;
    }


    .forgot-password {
        margin-top: 15px;
    }

        .forgot-password a {
            color: #1E8449;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s ease;
            display: inline-block;
            padding: 5px 0;
        }

            .forgot-password a:hover {
                color: #65A8B4;
                text-decoration: underline;
            }
</style>

<div class="login-container">
    <div class="login-box">
        <div class="login-image">
            <img src="images/Gemini.png" alt="Welcome Image" width="150" height="150" />
        </div>

        <h2 style="color: #2A737E; margin-bottom: 20px;">Oscorp Login</h2>

        <form asp-controller="Login" asp-action="Index" method="post">
            <div class="form-group">
                <!-- Label for Username -->
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <!-- Label for Password -->
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary">Sign In</button>

            <div class="forgot-password">
                <!-- /Login/ForgotPassword -->
                <a asp-controller="Login" asp-action="ForgotPassword">
                    <i class="fas fa-key"></i> Forgot Password?
                </a>
            </div>
        </form>
    </div>
</div>
<!-- Include Font Awesome for the key icon -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
