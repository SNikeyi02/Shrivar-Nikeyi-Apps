@model Prog_POE.Models.ForgotPasswordView

@{
    ViewData["Title"] = "Forgot Password";
    // Define the color palette variables for easy reference
    var darkGreen = "#1E8449";
    var lightGrayGreen = "#D1D4C7";
    var mutedCyan = "#65A8B4";
    var darkTeal = "#2A737E";
}

<style>
    body {
        background-color: @lightGrayGreen;
    }

    .forgot-container {
        font-family: 'Segoe UI', sans-serif;
        padding: 40px; 
        max-width: 400px;
        margin: 10vh auto; 
        background-color: white; 
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(42, 115, 126, 0.2);
        border-top: 5px solid @darkGreen; 
    }

        .forgot-container h2 {
            /* Header */
            color: @darkTeal;
            margin-bottom: 25px;
            text-align: center;
            font-weight: 600;
        }

        .forgot-container label {
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
            color: #333;
        }

        .forgot-container input {
            width: 100%;
            margin-bottom: 15px;
            padding: 10px;
            font-size: 16px;
            border: 1px solid @mutedCyan;
            border-radius: 5px;
            transition: border-color 0.3s ease;
        }

            .forgot-container input:focus {
                outline: none;
                border-color: @darkTeal; 
                box-shadow: 0 0 0 2px rgba(30, 132, 73, 0.2);
            }

        .forgot-container button {
            width: 100%;
            padding: 12px;
            background-color: @darkGreen;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.3s ease, transform 0.1s ease;
        }

            .forgot-container button:hover {
                background-color: @darkTeal;
                transform: translateY(-1px);
            }

    .forgot-message {
        margin-top: 20px;
        text-align: center;
        font-size: 16px;
        color: @darkGreen;
        font-weight: 500;
        padding: 10px;
        border: 1px dashed @mutedCyan;
        border-radius: 4px;
        background-color: #f0f8f8;
    }

    .back-to-login {
        display: block;
        margin-top: 20px;
        text-align: center;
    }

        .back-to-login a {
            color: @darkTeal;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s ease;
        }

            .back-to-login a:hover {
                color: @darkGreen;
                text-decoration: underline;
            }
</style>

<!-- Container for the Forgot Password form -->
<div class="forgot-container">

    <!-- Page heading -->
    <h2>Reset Password</h2>

    <!-- Instructional message for the user -->
    <p style="text-align: center; margin-bottom: 25px; color: #555;">
        Enter your Username below to receive instructions on resetting your password.
    </p>

    <!-- Form that posts the username to the ForgotPassword action -->
    <form asp-action="ForgotPassword" method="post">
        <!-- Label and input field bound to the Username property -->
        <label asp-for="Username">Username</label>
        <input asp-for="Username" type="text" />

        <!-- Validation message for the Username field -->
        <span asp-validation-for="Username" class="text-danger"></span>

        <!-- Submit button to trigger password reset request -->
        <button type="submit">Submit Request</button>
    </form>

    <!-- Conditional message display after form submission -->
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <!-- Feedback message shown to the user (e.g., success or error) -->
        <div class="forgot-message">@Model.Message</div>
    }

    <!-- Link to return to the login page -->
    <div class="back-to-login">
        <a href="/Login/Index">← Back to Login</a>
    </div>
</div>
