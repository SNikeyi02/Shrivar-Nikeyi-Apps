@model ERP.Models.ServiceRequest

@{
    ViewData["Title"] = "Create Service Request";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">New Logistics Service Request</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Associated Active Contract</label>

                            <input type="hidden" asp-for="ContractID" value="@Model.ContractID" />

                            <div class="card bg-light border-start border-primary border-3 shadow-xs">
                                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge bg-primary text-uppercase me-2 py-2 px-3">
                                            @(Model.Contract?.ServiceLevel ?? "Standard Logistics") Suite
                                        </span>
                                        <small class="text-muted font-monospace d-block d-sm-inline mt-1 mt-sm-0">
                                            ID: @Model.ContractID.ToString().Substring(0, 8)...
                                        </small>
                                    </div>
                                    <div class="text-end text-success fw-bold small">
                                        <i class="bi bi-shield-check"></i> Valid Until: @(Model.Contract?.EndDate.ToShortDateString() ?? DateTime.Now.AddYears(1).ToShortDateString())
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Transport Method (Factory Type)</label>
                                <select name="requestType" class="form-select form-control-lg" required>
                                    <option value="Road">Road Freight</option>
                                    <option value="Air">Air Freight</option>
                                    <option value="Sea">Sea Freight</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Weight" class="form-label fw-bold">Cargo Weight (kg)</label>
                                <input asp-for="Weight" class="form-control" type="number" step="0.1" required placeholder="Enter weight in kg" />
                                <span asp-validation-for="Weight" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Shipment Details</label>
                            <textarea asp-for="Description" class="form-control" rows="3" required placeholder="Provide structural cargo details or route specifications..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="card bg-light border-0 mb-4">
                            <div class="card-body p-3">
                                <label asp-for="CostUSD" class="form-label fw-bold text-dark">Quote Amount (USD)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 fw-bold">$</span>
                                    <input asp-for="CostUSD" class="form-control border-start-0 ps-1" type="number" step="0.01" placeholder="0.00" required />
                                </div>
                                <span asp-validation-for="CostUSD" class="text-danger small"></span>
                                <div class="form-text mt-2 text-muted">
                                    The ZAR equivalent will be calculated automatically using current market rates.
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-2 border-top">
                            <a asp-action="Index" asp-controller="Client" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-success px-4 fw-bold">Submit Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}