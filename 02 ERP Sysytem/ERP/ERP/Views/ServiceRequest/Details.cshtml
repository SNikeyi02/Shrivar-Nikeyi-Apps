@model ERP.Models.ServiceRequest

<div class="container mt-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3>Request Details: @Model.ServiceRequestId</h3>
            <span class="badge bg-info">@Model.Status</span>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Transport Type</dt>
                <dd class="col-sm-9">@Model.Type</dd>

                <dt class="col-sm-3">Weight</dt>
                <dd class="col-sm-9">@Model.Weight kg</dd>

                <dt class="col-sm-3">USD Amount</dt>
                <dd class="col-sm-9">$@Model.CostUSD.ToString("N2")</dd>

                <dt class="col-sm-3 text-primary">ZAR Equivalent</dt>
                <dd class="col-sm-9 text-primary font-weight-bold">R @Model.CostZAR.ToString("N2")</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Index" asp-controller="Client" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>
</div>