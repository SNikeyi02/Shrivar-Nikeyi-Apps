@model Prog_POE.Models.LecturerClaimView

@{
    ViewData["Title"] = "Submit Claim";

    // COLOR PALETTE
    var darkGreen = "#1E8449";
    var lightGrayGreen = "#D1D4C7";
    var mutedCyan = "#65A8B4";
    var darkTeal = "#2A737E";
    var neutralGray = "#F8F8F8";
}

<style>
    body {
        background-color: @lightGrayGreen;
        font-family: 'Segoe UI', sans-serif;
    }

    .form-container {
        padding: 40px;
        max-width: 900px;
        margin: 50px auto;
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        border-top: 5px solid @darkGreen;
    }

    .form-header {
        position: relative;
        text-align: center;
        margin-bottom: 30px;
        border-bottom: 2px solid @mutedCyan;
        padding-bottom: 15px;
    }

    .form-container h2 {
        color: @darkTeal;
        font-size: 32px;
        margin: 0;
    }

    .btn-back {
        position: absolute;
        left: 0;
        top: 0;
        padding: 8px 15px;
        background-color: #ddd;
        color: #555;
        border: none;
        border-radius: 5px;
        text-decoration: none;
        font-weight: 600;
        transition: background-color 0.2s, color 0.2s;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .btn-back:hover {
            background-color: @darkTeal;
            color: white;
        }

    .form-group {
        margin-bottom: 20px;
    }

    .form-row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }

        .form-row .form-group {
            flex: 1;
            margin-bottom: 0;
        }

    label {
        display: block;
        color: @darkTeal;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 15px;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background-color: @neutralGray;
        transition: border-color 0.3s, box-shadow 0.3s;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: @mutedCyan;
            box-shadow: 0 0 0 3px rgba(101, 168, 180, 0.2);
            outline: none;
            background-color: white;
        }

    textarea.form-control {
        resize: vertical;
        min-height: 120px;
    }

    .rate-info {
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background-color: #E8F5E9; 
        color: @darkGreen;
        font-weight: 600;
        text-align: center;
        box-sizing: border-box;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* --- Validation and Errors --- */
    .text-danger {
        color: @darkTeal; 
        font-size: 13px;
        margin-top: 5px;
        display: block;
    }

    .input-validation-error {
        border-color: @darkTeal !important;
    }

    .file-input-wrapper {
        border: 2px dashed @mutedCyan;
        padding: 20px;
        border-radius: 6px;
        text-align: center;
        background-color: #f0f8f8;
    }

        .file-input-wrapper input[type="file"] {
            display: block;
            margin: 10px auto;
        }

    /* --- Submission Button --- */
    .btn-submit {
        display: block;
        width: 100%;
        padding: 15px;
        background-color: @darkGreen;
        color: white;
        font-size: 18px;
        font-weight: bold;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.3s, transform 0.1s;
        margin-top: 30px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

        .btn-submit:hover {
            background-color: #1a713b;
            transform: translateY(-2px);
        }
</style>

<div class="form-container">
    <div class="form-header">
        <a asp-controller="Lecturer" asp-action="Home" class="btn-back">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
        <h2>Claim Submission Form</h2>
    </div>

    <form asp-action="SubmitClaim" asp-controller="Lecturer" method="post" enctype="multipart/form-data">

        <input type="hidden" asp-for="ClaimId" />
        <input type="hidden" asp-for="Status" />
        <input type="hidden" asp-for="LecturerName" value="[Auto-Populated Lecturer Name]" />

        <input type="hidden" asp-for="HourlyRate" />

        <input type="hidden" asp-for="OvertimeRate"/>

        @* <div class="form-group">
            <input type="hidden" asp-for="ClaimDate" class="form-control" type="datetime-local" />
        </div> *@

        @* Row 1: Hours Worked and Hourly Rate *@
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="HoursWorked">Hours Worked</label>
                    <input asp-for="HoursWorked" type="number" step="0.5" class="form-control" placeholder="e.g., 10.5" />
                    <span asp-validation-for="HoursWorked" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="HourlyRate">Hourly Rate</label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input asp-for="HourlyRate" type="text" class="form-control" value="75.00" readonly />
                    </div>
                </div>
            </div>
        </div>


        @* Row 2: Overtime Hours and Overtime Rate *@
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="OvertimeHours">Overtime Hours</label>
                    <input asp-for="OvertimeHours" type="number" step="0.5" class="form-control" placeholder="Optional: e.g., 5.0" />
                    <span asp-validation-for="OvertimeHours" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="OvertimeRate">Overtime Rate</label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input asp-for="OvertimeRate" type="text" class="form-control" value="150.00" readonly />
                    </div>
                </div>
            </div>
        </div>

        @* Row 3: Description *@
        <div class="form-group">
            <label asp-for="Description">Description *</label>
            <textarea asp-for="Description" class="form-control" placeholder="Provide a detailed description of the work performed..." required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        @* Row 4: Supporting Documents *@
        <div class="form-group">
            <label asp-for="SupportingDocuments">Supporting Documents</label>
            <div class="file-input-wrapper">
                <input type="file" name="SupportingDocuments" multiple class="form-control-file" />
                <p style="color:#777; font-size:14px;">Select one or more files (e.g., timesheets, completion certificates).</p>
            </div>
        </div>

        <button type="submit" class="btn-submit">
            <i class="fas fa-file-upload"></i> Submit Claim
        </button>
    </form>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
