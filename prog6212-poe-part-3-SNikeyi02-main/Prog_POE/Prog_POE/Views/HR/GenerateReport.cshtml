@model Prog_POE.Models.ReportFilter

@{
    ViewData["Title"] = "Generate Reports";

    var darkGreen = "#1E8449";
    var lightGrayGreen = "#D1D4C7";
    var mutedCyan = "#65A8B4";
    var darkTeal = "#2A737E";
}

<style>
    body {
        background-color: @lightGrayGreen;
        font-family: 'Segoe UI', sans-serif;
    }

    .container {
        max-width: 1000px;
        margin: 30px auto;
        padding: 30px;
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        border-top: 5px solid @darkGreen;
    }

    .header {
        text-align: center;
        margin-bottom: 30px;
        border-bottom: 2px solid @mutedCyan;
        padding-bottom: 20px;
    }

        .header h1 {
            color: @darkTeal;
            margin: 0;
        }

    .form-group {
        margin-bottom: 20px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        color: @darkTeal;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        box-sizing: border-box;
    }

    .btn-generate {
        background-color: @darkGreen;
        color: white;
        padding: 12px 30px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
        margin-right: 10px;
    }

    .btn-preview {
        background-color: @mutedCyan;
        color: white;
        padding: 12px 30px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
    }

    .report-type {
        display: flex;
        gap: 20px;
        margin: 20px 0;
    }

    .report-option {
        flex: 1;
        text-align: center;
        padding: 20px;
        border: 2px solid #ddd;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .report-option:hover {
            border-color: @mutedCyan;
        }

        .report-option.selected {
            border-color: @darkGreen;
            background-color: #f8fff8;
        }

        .report-option i {
            font-size: 32px;
            margin-bottom: 10px;
            color: @mutedCyan;
        }

        .report-option.selected i {
            color: @darkGreen;
        }

    .results-section {
        margin-top: 40px;
        display: none;
    }

        .results-section.visible {
            display: block;
        }
</style>

<div class="container">
    <div class="header">
        <h1><i class="fas fa-chart-bar"></i> Generate Reports</h1>
        <p>Generate comprehensive PDF and Excel reports for claims data</p>
    </div>

    <form asp-action="GenerateReport" method="post" id="reportForm">
        @Html.AntiForgeryToken()

        <div class="form-row">
            <div class="form-group">
                <label asp-for="LecturerName">Lecturer Name</label>
                <input asp-for="LecturerName" class="form-control" placeholder="Search by lecturer name" />
            </div>

            <div class="form-group">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-control">
                    <option value="">All Statuses</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="MinAmount">Minimum Amount (R)</label>
                <input asp-for="MinAmount" type="number" step="0.01" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="MaxAmount">Maximum Amount (R)</label>
                <input asp-for="MaxAmount" type="number" step="0.01" class="form-control" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="StartDate">Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="EndDate">End Date</label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label>Report Type</label>
            <div class="report-type">
                <div class="report-option" data-type="PDF">
                    <i class="fas fa-file-pdf"></i>
                    <h3>PDF Report</h3>
                    <p>Professional formatted document</p>
                </div>
                <div class="report-option" data-type="Excel">
                    <i class="fas fa-file-excel"></i>
                    <h3>Excel Report</h3>
                    <p>Spreadsheet with raw data</p>
                </div>
            </div>
            <input type="hidden" asp-for="ReportType" id="ReportType" value="PDF" />
        </div>

        <div class="form-group">
            <button type="submit" class="btn-generate" name="action" value="generate">
                <i class="fas fa-download"></i> Generate Report
            </button>
            <button type="submit" class="btn-preview" name="action" value="preview">
                <i class="fas fa-eye"></i> Preview Results
            </button>
        </div>
    </form>

    @if (ViewBag.ReportResults != null)
    {
        <div class="results-section visible">
            <h3><i class="fas fa-list"></i> Preview Results (@ViewBag.ReportResults.Count records found)</h3>

            @if (ViewBag.ReportResults.Count > 0)
            {
                <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                    <thead>
                        <tr style="background-color: @mutedCyan; color: white;">
                            <th style="padding: 10px; text-align: left;">Claim ID</th>
                            <th style="padding: 10px; text-align: left;">Lecturer</th>
                            <th style="padding: 10px; text-align: left;">Amount</th>
                            <th style="padding: 10px; text-align: left;">Status</th>
                            <th style="padding: 10px; text-align: left;">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in ViewBag.ReportResults)
                        {
                            <tr style="border-bottom: 1px solid #ddd;">
                                <td style="padding: 10px;">@claim.Id</td>
                                <td style="padding: 10px;">@claim.Lecturer?.FirstName @claim.Lecturer?.LastName</td>
                                <td style="padding: 10px;">R @claim.TotalClaimAmount.ToString("N2")</td>
                                <td style="padding: 10px;">@claim.Status</td>
                                <td style="padding: 10px;">@claim.WorkDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="text-align: center; color: #666; padding: 20px;">
                    No claims match your filter criteria.
                </p>
            }
        </div>
    }
</div>

<script>
    // Report type selection
    document.querySelectorAll('.report-option').forEach(option => {
        option.addEventListener('click', function() {
            document.querySelectorAll('.report-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            this.classList.add('selected');
            document.getElementById('ReportType').value = this.getAttribute('data-type');
        });
    });

    // Set first option as selected by default
    document.querySelector('.report-option').classList.add('selected');
</script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">