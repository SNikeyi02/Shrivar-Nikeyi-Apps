@{
    ViewData["Title"] = "Information for Parents";
}

<style>

    .parents-container {
        font-family: 'Segoe UI', sans-serif;
        padding: 60px;
        /* Background: Light Gray-Green */
        background-color: #D1D4C7;
        color: #333;
        max-width: 900px;
        margin: 50px auto;
        border-radius: 12px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .parents-header {
        font-size: 36px;
        font-weight: bold;
        /* Header: Dark Green */
        color: #1E8449;
        margin-bottom: 30px;
        border-bottom: 3px solid #65A8B4; /* Accent line */
        display: inline-block;
        padding-bottom: 10px;
    }

    .parents-section {
        margin-bottom: 40px;
        border-left: 5px solid #65A8B4; 
        padding-left: 20px;
    }

        .parents-section h3 {
            font-size: 24px;
            color: #2A737E;
            margin-bottom: 10px;
        }

        .parents-section p {
            font-size: 16px;
            line-height: 1.6;
            color: #4a4a4a;
        }

        .parents-section ul {
            list-style: disc;
            margin-left: 20px;
            padding-left: 0;
        }

        .parents-section li {
            margin-bottom: 8px;
            color: #2A737E; 
        }


    .parents-buttons {
        text-align: center;
        margin-top: 40px;
    }

        .parents-buttons a {
            padding: 15px 35px;
            font-size: 18px;
            /* Button Background: Dark Green */
            background-color: #1E8449;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            transition: background-color 0.2s ease, transform 0.2s ease;
            box-shadow: 0 6px 10px rgba(0, 0, 0, 0.2);
            display: inline-block;
        }

            .parents-buttons a:hover {
                /* Button Hover: Dark Teal */
                background-color: #2A737E;
                transform: translateY(-2px);
            }
</style>

<!-- Main container for the About Us page content -->
<div class="about-container">

    <!-- Page header -->
    <div class="about-header">About Us</div>

    <!-- Section introducing the platform and its mission -->
    <div class="about-section">
        <h3>Who We Are</h3>
        <p>
            Welcome to **Oscorp Pty** — a dynamic platform designed to streamline academic claims, empower lecturers, and simplify approval workflows for coordinators and managers. Our mission is to make claim submissions transparent, secure, and easy to manage.
        </p>
    </div>

    <!-- Section outlining key features and benefits of the system -->
    <div class="about-section">
        <h3>What We Offer</h3>
        <p>
            - A seamless claim submission system for lecturers<br />
            - Real-time approval tracking for academic managers and coordinators<br />
            - Secure document uploads and transparent status updates<br />
            - A user-friendly interface built with accessibility and clarity in mind
        </p>
    </div>

    <!-- Section explaining the broader impact and value of the platform -->
    <div class="about-section">
        <h3>Why It Matters</h3>
        <p>
            We believe in reducing administrative friction so educators can focus on what matters most 
            — teaching and learning. Our system ensures every claim is handled with care, accuracy, 
            and accountability.
        </p>
    </div>

    <!-- Navigation buttons linking to other key pages -->
    <div class="about-buttons">
        <a href="/Home/Available">Explore Jobs</a> <!-- Link to job listings -->
        <a href="/Home/Apply">Become a Student</a> <!-- Link to student application page -->
        <a href="/Home/Contact">Contact Us</a> <!-- Link to contact form or details -->
    </div>
</div>
