@{
    ViewData["Title"] = "About Us";
}

<style>

    .about-container {
        font-family: 'Segoe UI', sans-serif;
        padding: 60px;
        background-color: #D1D4C7;
        color: #333;
        max-width: 900px;
        margin: 50px auto;
        border-radius: 12px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .about-header {
        font-size: 36px;
        font-weight: bold;
        /* Used Dark Green for the main header color */
        color: #1E8449;
        margin-bottom: 30px;
        border-bottom: 3px solid #65A8B4; /* Accent line using Muted Cyan */
        display: inline-block;
        padding-bottom: 10px;
    }

    .about-section {
        margin-bottom: 40px;
        border-left: 5px solid #65A8B4; /* Muted Cyan accent line */
        padding-left: 20px;
    }

        .about-section h3 {
            font-size: 24px;
            /* Used Dark Teal for section headers */
            color: #2A737E;
            margin-bottom: 10px;
        }

        .about-section p {
            font-size: 16px;
            line-height: 1.6;
            color: #4a4a4a;
        }

            .about-section p br {
                display: block;
                margin-top: 5px;
            }

    .about-buttons {
        display: flex;
        gap: 20px;
        margin-top: 40px;
    }

        .about-buttons a {
            padding: 12px 25px;
            font-size: 16px;
            /* Used Dark Green for the button background */
            background-color: #1E8449;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            transition: background-color 0.2s ease, transform 0.2s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

            .about-buttons a:hover {
                /* Used Dark Teal for the button hover */
                background-color: #2A737E;
                transform: translateY(-1px);
            }
</style>

<div class="about-container">
    <div class="about-header">About Us</div>

    <div class="about-section">
        <h3>Who We Are</h3>
        <p>
            Welcome to **Oscorp Pty** — a dynamic platform designed to streamline academic claims, empower lecturers, and simplify approval workflows for coordinators and managers. Our mission is to make claim submissions transparent, secure, and easy to manage.
        </p>
    </div>

    <div class="about-section">
        <h3>What We Offer</h3>
        <p>
            - A seamless claim submission system for lecturers<br />
            - Real-time approval tracking for academic managers and coordinators<br />
            - Secure document uploads and transparent status updates<br />
            - A user-friendly interface built with accessibility and clarity in mind
        </p>
    </div>

    <div class="about-section">
        <h3>Why It Matters</h3>
        <p>
            We believe in reducing administrative friction so educators can focus on what matters most — teaching and learning. Our system ensures every claim is handled with care, accuracy, and accountability.
        </p>
    </div>

    <div class="about-buttons">
        <a href="/Home/Available">Explore Jobs</a>
        <a href="/Home/Apply">Become a Student</a>
        <a href="/Home/Contact">Contact Us</a>
    </div>
</div>
